# Réglages du serveur pour le site Madame Cho, générés par gen.py (passe SEO du 03/11/2026) : ne pas modifier à la main.

# Version d'essai : le dossier atelier-site/ refuse les .js (scripts de feuille) ; ici, les scripts du site
# (panier et formulaire) doivent être servis. Le reste des règles d'atelier-site/ s'applique.
<FilesMatch "\.js$">
  Require all granted
</FilesMatch>

# Page introuvable
ErrorDocument 404 /atelier-site/site/404.html

# Types des fichiers
AddType image/webp .webp
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest

# Compression des textes
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml application/manifest+json
  </IfModule>
</IfModule>

# Cache du navigateur : les feuilles de style et scripts portent leur version (?v=…), les pages sont toujours relues
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# En-têtes de sécurité (audit du site, C09) ; la politique de contenu n'autorise que les fichiers du site
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
</IfModule>

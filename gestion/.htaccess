# Espace de gestion de Madame Cho : réservé (connexion), jamais indexé ; seule la page index.php est servie, avec son habillage
DirectoryIndex index.php
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  # Le micro, ici seulement : le mode vocal de l'assistant (demande d'Olivier, 07/11/2026) ; le reste du site le refuse toujours
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=(), payment=()"
</IfModule>
<FilesMatch "\.php$">
  Require all denied
</FilesMatch>
<Files "index.php">
  Require all granted
</Files>
